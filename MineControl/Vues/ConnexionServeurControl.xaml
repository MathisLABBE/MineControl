<UserControl x:Class="MineControl.Vues.ConnexionServeurControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MineControl.Vues"
             xmlns:vm="clr-namespace:MineControl.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnexionServeurViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="650" d:DesignWidth="800"
             Loaded="ConnexionServeurControl_Loaded">

    <Grid>
        <StackPanel
            Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="MineControl"
                FontSize="30"
                FontWeight="Bold"
                TextAlignment="Center"
                Margin="0,0,0,25"/>

            <TextBlock
                Text="Passphrase de la clé SSH"
                FontSize="14"
                Margin="0,0,0,5"/>

            <PasswordBox
                x:Name="PbPassphrase"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <Button
                Content="Se connecter"
                Height="45"
                IsDefault="True"
                Click="BtnConnexion_Click"/>

            <TextBlock
                Text="{Binding StatutConnexion}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                FontSize="15"
                Margin="0,20,0,0"/>

            <TextBlock
                Text="{Binding EtatServeur}"
                FontSize="16" />

            <TextBlock
                Text="{Binding DerniereActualisation, StringFormat='Dernière actualisation : {0:HH:mm:ss}'}"
                FontSize="13"
                Margin="0,5,0,0"/>

            <Button
                Content="Actualiser l'état"
                Height="35"
                Margin="0,10,0,0"
                Click="BtnActualiserEtat_Click"/>

            <TextBlock
                Text="Adresse IP du serveur"
                FontSize="14"
                Margin="0,0,0,5"/>

            <TextBox
                Text="{Binding AdresseIp, UpdateSourceTrigger=PropertyChanged}"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <TextBlock
                Text="Port SSH"
                FontSize="14"
                Margin="0,0,0,5"/>

            <TextBox
                Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <TextBlock
                Text="Utilisateur SSH"
                FontSize="14"
                Margin="0,0,0,5"/>

            <TextBox
                Text="{Binding NomUtilisateur, UpdateSourceTrigger=PropertyChanged}"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <TextBlock
                Text="Chemin de la clé privée"
                FontSize="14"
                Margin="0,0,0,5"/>

            <TextBox
                Text="{Binding CheminCle, UpdateSourceTrigger=PropertyChanged}"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <TextBlock
                Text="Empreinte SHA-256 de l'hôte"
                FontSize="14"
                Margin="0,0,0,5"/>

            <TextBox
                Text="{Binding EmpreinteHoteSha256, UpdateSourceTrigger=PropertyChanged}"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <Button
                Content="Enregistrer le profil"
                Height="38"
                Margin="0,0,0,15"
                Click="BtnEnregistrerProfil_Click"/>

        </StackPanel>
    </Grid>
</UserControl>
