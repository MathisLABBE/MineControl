<Window x:Class="MineControl.MainWindow"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MineControl"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainWindow, IsDesignTimeCreatable=True}"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <StackPanel
            Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="MineControl"
                FontSize="30"
                FontWeight="Bold"
                TextAlignment="Center"
                Margin="0,0,0,25"/>

            <TextBlock Text="Passphrase de la clé SSH"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <PasswordBox
                x:Name="PbPassphrase"
                Height="38"
                Padding="8,5"
                Margin="0,0,0,15"/>

            <Button
                x:Name="BtnTestConnexionSSH"
                Content="Se connecter"
                Height="45"
                IsDefault="True"
                Click="BtnTestConnexionSSH_Click"/>

            <TextBlock
                Text="{Binding TbTestConnexion}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                FontSize="15"
                Margin="0,20,0,0"/>

        </StackPanel>
    </Grid>
</Window>