<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	
	<!-- Valeurs par défaut affichées au premier lancement.
	     Renseignez-les ici ou directement dans l'application :
	     le profil saisi est ensuite enregistré dans %LOCALAPPDATA%\MineControl\ProfilServeur.Json. -->
	<appSettings>
		<add key="SshAdresseIp" value="" />
		<add key="SshNomUtilisateur" value="" />
		<add key="SshPort" value="22" />
		<add key="SshCheminCle" value=""/>
		<add key="SshEmpreinteHote" value=""/>
	</appSettings>
	
</configuration>